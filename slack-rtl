#!/bin/bash
# Launch Slack with a local debug port and inject Hebrew RTL support.
# Re-running while Slack is already up just re-applies the injection.
set -u

PORT="${SLACK_RTL_PORT:-9222}"
DIR="$(cd "$(dirname "$0")" && pwd)"
SLACK_BIN="/Applications/Slack.app/Contents/MacOS/Slack"
# Slack 4.53+ refuses --remote-debugging-port on the default profile, so the
# RTL launcher runs Slack on its own profile folder. It is seeded once from the
# default profile (caches skipped) so you stay signed in.
DEFAULT_PROFILE="$HOME/Library/Application Support/Slack"
PROFILE="${SLACK_RTL_PROFILE:-$DIR/profile}"

if [ ! -x "$SLACK_BIN" ]; then
  echo "Slack.app not found in /Applications." >&2
  exit 1
fi

port_up() {
  curl -s -m 1 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1
}

if ! port_up; then
  if pgrep -xq Slack; then
    echo "Slack is running without the debug port — restarting it..."
    osascript -e 'quit app "Slack"' >/dev/null 2>&1
    for _ in $(seq 1 30); do
      pgrep -xq Slack || break
      sleep 0.5
    done
  fi
  if [ ! -d "$PROFILE" ] && [ -d "$DEFAULT_PROFILE" ]; then
    echo "Creating the RTL profile from your Slack profile (one time)..."
    mkdir -p "$PROFILE"
    rsync -a \
      --exclude 'Cache' --exclude 'Code Cache' --exclude 'GPUCache' \
      --exclude 'Dawn*' --exclude 'GraphiteDawnCache' --exclude 'GPUPersistentCache' \
      --exclude 'Crashpad' --exclude 'StaleCookies-*' --exclude 'DevToolsActivePort' \
      --exclude 'Singleton*' --exclude 'logs' \
      "$DEFAULT_PROFILE/" "$PROFILE/"
  fi
  echo "Launching Slack (debug port $PORT)..."
  nohup "$SLACK_BIN" --user-data-dir="$PROFILE" --remote-debugging-port="$PORT" >/dev/null 2>&1 &
  disown
fi

for _ in $(seq 1 30); do
  port_up && break
  sleep 1
done

if ! port_up; then
  echo "Slack's debug port never came up — Slack may be blocking --remote-debugging-port." >&2
  exit 1
fi

/usr/bin/python3 "$DIR/inject.py"
status=$?

# Keep watching while Slack runs, so windows opened later (a channel or DM
# popped out into its own window) get RTL too. Only one watcher runs at a time.
nohup /usr/bin/python3 "$DIR/inject.py" --watch >/dev/null 2>&1 &
disown
exit $status
